      object lstWrap: TDaisyFmxList
        Position.X = 824.000000000000000000
        Position.Y = 8.000000000000000000
        Size.Width = 380.000000000000000000
        Size.Height = 368.000000000000000000
        Size.PlatformDefault = False
        TabOrder = 53
        Items = <
          item
            Title = 'Fix login bug'
            Subtitle = 'High priority'
            Description = 
              'Users on older browsers cannot sign in after the latest release.' +
              ' Reproduce, patch and add a regression test.'
            Icon.Emoji = #55357#56613
            Action.SVG.Strings = (
              
                '<svg viewBox="0 0 24 24" fill="none" stroke="currentColor"><path' +
                ' d="M9 5l7 7-7 7"/></svg>')
          end
          item
            Title = 'Automate reports'
            Subtitle = 'Medium priority'
            Description = 'Replace the weekly manual export with a scheduled bot run.'
            Icon.Emoji = #55358#56598
            Action.SVG.Strings = (
              
                '<svg viewBox="0 0 24 24" fill="none" stroke="currentColor"><path' +
                ' d="M9 5l7 7-7 7"/></svg>')
          end
          item
            Title = 'Fix Main Form'
            Subtitle = 'Cosmetic Nightmare'
            Description = 
              'Replace the horrible looking UI that is the main form with somet' +
              'hing that won'#39't get us all canned'
            Icon.Emoji = #55357#56613
          end>
        Header = 'Third column wraps'
        Layout = llThirdWraps
        OnItemClick = ListItemClick
      end
