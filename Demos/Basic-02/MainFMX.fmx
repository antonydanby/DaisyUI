      object accSeparate: TDaisyFmxAccordion
        Position.X = 16.000000000000000000
        Position.Y = 44.000000000000000000
        Size.Width = 480.000000000000000000
        Size.Height = 226.000000000000000000
        Size.PlatformDefault = False
        Items = <
          item
            Title = 'How do I create an account?'
            Content = 
              'Click the Sign Up button in the top right corner and follow the ' +
              'on-screen steps.'
            Expanded = True
          end
          item
            Title = 'I forgot my password'
            Content = 
              'Use the Forgot password link on the sign in page to receive a re' +
              'set email.'
          end
          item
            Title = 'How do I update my profile?'
            Content = 'Open Settings, choose Profile and edit your details, then save.'
          end>
        OnToggle = AccordionToggle
      end
      object accJoined: TDaisyFmxAccordion
        Variant = dvPrimary
